# Discord Application ID（Bot Portal → General Information → Application ID）
VITE_DISCORD_CLIENT_ID=你的_Application_ID

# OAuth2 redirect URI（需與 Discord Developer Portal OAuth2 → Redirects 一致）
VITE_REDIRECT_URI=https://poketower-activity.pages.dev

# API base URL（留空表示使用相對路徑 /api，搭配 Cloudflare proxy 或 wrangler）
# VITE_API_BASE_URL=https://p01--soyorin--p2mfw9lq5dgw.code.run
